{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace-launcher.local/schemas/pet-model-v3.json",
  "title": "LaunchPad Full State 22 Pet",
  "type": "object",
  "required": ["schemaVersion", "modelStandard", "id", "displayName", "render", "semantics", "presentation"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "modelStandard": {
      "type": "object",
      "required": ["name", "version", "profile"],
      "properties": {
        "name": { "const": "workspace-launcher-pet" },
        "version": { "const": 1 },
        "profile": { "const": "full-state-22" }
      },
      "additionalProperties": false
    },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 500 },
    "render": {
      "type": "object",
      "required": ["engine", "canvas", "animations"],
      "properties": {
        "engine": { "const": "sprite2d" },
        "canvas": {
          "type": "object",
          "required": ["mode", "width", "height"],
          "properties": {
            "mode": { "const": "fixed" },
            "width": { "const": 192 },
            "height": { "const": 208 }
          }
        },
        "animations": {
          "type": "object",
          "required": [
            "idle", "running-right", "running-left", "waving", "jumping", "failed", "waiting", "running", "review",
            "look-row-9", "look-row-10", "picked-up", "dragging-left", "dragging-right", "drag-hold", "falling",
            "landing", "sleep", "wake-up", "happy", "angry", "sad"
          ],
          "minProperties": 22,
          "maxProperties": 22,
          "additionalProperties": { "$ref": "#/$defs/animation" }
        }
      }
    },
    "semantics": {
      "type": "object",
      "required": ["bindings"],
      "properties": {
        "bindings": { "type": "object", "minProperties": 22 }
      }
    },
    "interactions": { "type": "object" },
    "behavior": { "type": "object" },
    "presentation": {
      "type": "object",
      "required": ["defaultEmotion", "defaultIntent"],
      "properties": {
        "defaultEmotion": { "type": "string" },
        "defaultIntent": { "const": "idle" }
      }
    }
  },
  "$defs": {
    "animation": {
      "type": "object",
      "required": ["source", "timing", "semantics", "interruptible"],
      "properties": {
        "source": {
          "type": "object",
          "required": ["type", "asset", "columns", "rows", "cellWidth", "cellHeight", "row", "startColumn", "frameCount"],
          "properties": {
            "type": { "const": "atlas" },
            "asset": { "type": "string", "pattern": "^[^/\\\\]+\\.(png|webp)$" },
            "columns": { "const": 8 },
            "rows": { "const": 22 },
            "cellWidth": { "const": 192 },
            "cellHeight": { "const": 208 },
            "row": { "type": "integer", "minimum": 0, "maximum": 21 },
            "startColumn": { "const": 0 },
            "frameCount": { "const": 8 }
          }
        },
        "timing": {
          "type": "object",
          "required": ["fps", "playback"],
          "properties": {
            "fps": { "type": "number", "minimum": 0.2, "maximum": 60 },
            "playback": { "enum": ["loop", "once", "hold"] }
          }
        },
        "semantics": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "interruptible": { "type": "boolean" }
      }
    }
  }
}
