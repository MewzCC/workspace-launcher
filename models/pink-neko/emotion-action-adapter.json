{
  "principle": "Preserve the project's existing emotion state machine. Resolve its events and emotions to the complete 22-row render-state set without replacing emotion logic.",
  "eventMap": {
    "startup": "idle",
    "hover": "waving",
    "click": "happy",
    "drag_start": "picked-up",
    "drag_stationary": "drag-hold",
    "drag_dx_negative": "dragging-left",
    "drag_dx_positive": "dragging-right",
    "drag_release": "falling",
    "landed": "landing",
    "task_assigned": "running",
    "task_review": "review",
    "task_success": "happy",
    "task_failure": "failed",
    "wait_user": "waiting",
    "sleep_timeout": "sleep",
    "wake": "wake-up"
  },
  "emotionFallback": {
    "calm": "idle",
    "curious": "look-row-9",
    "happy": "happy",
    "focused": "review",
    "sad": "sad",
    "angry": "angry",
    "sleepy": "sleep",
    "surprised": "picked-up"
  },
  "priority": [
    "drag/pick/fall/land action",
    "task action",
    "sleep/wake action",
    "explicit interaction action",
    "emotion fallback",
    "idle"
  ]
}
